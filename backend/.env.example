NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# SEPARATE MONGODB ATLAS ENVIRONMENTS
MAIN_MONGODB_URI=mongodb+srv://<user>:<password>@main-cluster.mongodb.net/vedixa_erp?retryWrites=true&w=majority
BACKUP_MONGODB_URI=mongodb+srv://<user>:<password>@backup-cluster.mongodb.net/vedixa_backups?retryWrites=true&w=majority

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP Email Configuration (Nodemailer / Gmail SMTP)
# For Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_gmail@gmail.com, SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM="VEDIXA ERP" <no-reply@vedixa.in>
APP_BASE_URL=http://localhost:5173
